# Supabase 项目设置 -> API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# AI 创意总结（LongCat，Anthropic 兼容接口）
# API Key 从 https://longcat.chat/platform 获取
AI_API_KEY=
AI_BASE_URL=https://api.longcat.chat/anthropic
AI_MODEL=LongCat-2.0

# Google Cloud Console 开启 YouTube Data API v3 后生成的 API Key
YOUTUBE_API_KEY=

# 团队访问口令保护（内部工具用，任意自定义字符串）
TEAM_ACCESS_CODE=
AUTH_SECRET=

# Vercel Cron 调用 /api/cron/youtube 时的鉴权密钥（任意随机字符串，与 Vercel 环境变量保持一致）
CRON_SECRET=
